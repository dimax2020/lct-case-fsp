# Demo stand only. These are not production secrets.
DOMAIN=localhost
POSTGRES_DSN=postgresql+asyncpg://fsp:fsp@postgres:5432/fsp
REDIS_URL=redis://redis:6379/0

KEYCLOAK_ISSUER=http://localhost/auth/realms/fsp
KEYCLOAK_CLIENT_ID=career-web
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Passwords of users imported from infra/keycloak/realm-export.json
DEMO_CANDIDATE_EMAIL=candidate@demo.fsp
DEMO_CANDIDATE_PASSWORD=candidate-demo
DEMO_EMPLOYER_EMAIL=employer@demo.fsp
DEMO_EMPLOYER_PASSWORD=employer-demo
DEMO_ADMIN_EMAIL=admin@demo.fsp
DEMO_ADMIN_PASSWORD=admin-demo

LLM_BASE_URL=https://llm-provider.example/v1
LLM_API_KEY=change-me
LLM_MODEL=qwen3-14b
LLM_ENABLED=false

EMBEDDING_MODEL=intfloat/multilingual-e5-base
PISTON_URL=http://piston:2000
PISTON_ENABLED=false

MATCH_ALPHA=1.0
MATCH_BETA=0.15

NUXT_PUBLIC_API_MOCKS=1
NUXT_OIDC_SESSION_SECRET=change-me-session-secret
