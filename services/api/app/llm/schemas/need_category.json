{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeedCategoryExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["specialization", "grades", "evidence_span"],
  "properties": {
    "specialization": {"type": "string", "enum": ["backend", "frontend", "data_ml", "devops"]},
    "grades": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"type": "string", "enum": ["intern", "junior", "middle", "senior", "lead"]}
    },
    "domain": {"type": ["string", "null"]},
    "evidence_span": {"type": "string", "minLength": 1}
  }
}
